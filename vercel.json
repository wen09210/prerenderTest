{
	"rewrites": [
	  {
		"source": "/(.*)",
		"has": [
		  {
			"type": "header",
			"key": "user-agent",
			"value": ".*(googlebot|bingbot|baiduspider|facebot|twitterbot|linkedinbot).*"
		  }
		],
		"destination": "https://service.prerender.io/https://prerender-test-ten.vercel.app/$1"
	  }
	],
	"headers": [
	  {
		"source": "/(.*)",
		"headers": [
		  {
			"key": "X-Prerender-Token",
			"value": "TCgx9MijlwMxRLwUgAIv"
		  }
		]
	  }
	]
  }
  