{
	"rewrites": [
	  {
		"source": "/(.*)",
		"has": [
		  {
			"type": "header",
			"key": "User-Agent",
			"value": ".*(Googlebot|Bingbot|Yandex|Baiduspider|Twitterbot|facebookexternalhit|LinkedInBot|Embedly|Slackbot).*"
		  }
		],
		"destination": "https://service.prerender.io/https://prerender-test-ten.vercel.app/$1"
	  }
	]
  }
  