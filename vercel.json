{
	"rewrites": [
		{
			"source": "/api/prerender/(.*)",
			"destination": "https://prerender.io/https://prerender-test-ten.vercel.app/$1"
		}
	],
	"headers": [
		{
			"source": "/api/prerender/(.*)",
			"headers": [
				{
					"key": "X-Prerender-Token",
					"value": "TCgx9MijlwMxRLwUgAIv"
				}
			]
		}
	]
}
