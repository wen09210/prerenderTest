{
	"rewrites": [
	  {
		"source": "/(.*)",
		"has": [
		  {
			"type": "header",
			"key": "User-Agent",
			"value": ".*([Gg]ooglebot|[Bb]ingbot|[Yy]andex|[Bb]aiduspider|[Tt]witterbot|facebookexternalhit|[Ll]inkedinbot|[Ee]mbedly|[Ss]lackbot).*"
		  }
		],
		"destination": "/api/debug"
	  },
	  {
		"source": "/(.*)",
		"destination": "/$1"
	  }
	]
  }
  